{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "allowJs": false,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["chrome-types"],
    "baseUrl": ".",
    "paths": {
      "@/background/*": ["src/background/*"],
      "@/content/*": ["src/content/*"],
      "@/db/*": ["src/db/*"],
      "@/dashboard/*": ["src/dashboard/*"],
      "@/options/*": ["src/options/*"],
      "@/utils/*": ["src/utils/*"]
    }
  },
  "include": ["src", "manifest.json", "vite.config.ts"],
  "exclude": ["dist", "node_modules"]
}


